{
  "name": "wrestling-vault",
  "version": "0.1.0",
  "private": true,
  "description": "A personal wrestling match archive with local video playback.",
  "author": "Wrestling Vault",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "test:desktop": "node scripts/smoke-electron.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:player": "node scripts/smoke-player.mjs",
    "test:import": "node scripts/smoke-import.mjs",
    "test:lookup": "node scripts/smoke-lookup.mjs",
    "test:artwork": "node scripts/smoke-artwork.mjs",
    "test:batch": "node scripts/smoke-batch.mjs",
    "dist:win": "npm run build && node scripts/collect-licenses.mjs && electron-builder --win nsis --x64 --publish never",
    "pack:dir": "npm run build && node scripts/collect-licenses.mjs && electron-builder --dir --publish never",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "cheerio": "1.1.2",
    "lucide-react": "1.56.0",
    "motion": "14.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
